{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.claude",
      "!**/node_modules",
      "!**/dist",
      "!**/bun.lock",
      "!**/*.lock",
      "!apps/api/src/db/queries.gen.ts",
      "!apps/dashboard/src/routeTree.gen.ts",
      "!apps/www/src/routeTree.gen.ts",
      "!apps/www/worker-configuration.d.ts",
      "!packages/cli/src/command-tree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 1
          }
        }
      },
      "performance": {
        "noBarrelFile": "error"
      },
      "suspicious": {
        "useAwait": "error",
        "noDeprecatedImports": "error"
      },
      "nursery": {
        "useAwaitThenable": "error",
        "useReactFunctionComponentDefinition": {
          "level": "error",
          "options": {
            "namedComponents": "functionDeclaration"
          }
        },
        "noFloatingPromises": "error",
        "useSortedClasses": {
          "level": "error",
          "options": {
            "functions": ["clsx", "cva", "cn", "tw", "tw.*"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "error",
        "noMagicNumbers": "error",
        "noExportedImports": "error",
        "useFilenamingConvention": {
          "level": "off",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 100
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.tsx", "!packages/ui/src/components/*.tsx"],
      "plugins": ["./biome-plugins/no-optional-props.grit"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": {
              "level": "error",
              "options": {
                "style": "type"
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/repositories/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#routes/**", "#services/**"],
                    "message": "Repositories must not depend on controllers or services."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/services/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#routes/**"],
                    "message": "Services must not depend on controllers."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/routes/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#repositories/**"],
                    "message": "Controllers must depend on services, not repositories."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/**/*.test.*", "**/src/**/*.spec.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun:test": "Tests live in a sibling `tests/` directory, never under `src/`."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/*.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "useReactFunctionComponentDefinition": "off"
          },
          "a11y": {
            "noLabelWithoutControl": "off",
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          },
          "complexity": {
            "useMaxParams": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!apps/api/**",
        "!apps/agent/**",
        "!packages/protocol/**",
        "!packages/api-client/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@repo/api", "@repo/api/**", "**/apps/api/**"],
                    "message": "Public consumers use @repo/api-client. Derive request and response types from its exported Treaty client."
                  },
                  {
                    "group": [
                      "@repo/protocol",
                      "@repo/protocol/**",
                      "!@repo/protocol/runtime-values",
                      "**/packages/protocol/**"
                    ],
                    "message": "Public API types come from @repo/api-client. Only the schema-free protocol/runtime-values subpath is public."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/protocol/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@repo/**", "!@repo/typebox-extensions"],
                    "message": "The API-agent wire contract may depend only on TypeBox schema extensions, never on applications or other workspace packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/agent/**/*.ts", "apps/agent/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@repo/api", "@repo/api/*", "**/apps/api/**"],
                    "message": "The agent must not import the API. Shared API-agent communication belongs in @repo/protocol."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/api-client/**/*.ts",
        "packages/api-client/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@repo/api": "The client may reference only API route types."
                },
                "patterns": [
                  {
                    "group": [
                      "@repo/api/**",
                      "!@repo/api/types",
                      "**/apps/api/**",
                      "@repo/protocol",
                      "@repo/protocol/**",
                      "**/packages/protocol/**"
                    ],
                    "message": "Client runtime code must not depend on API or protocol implementation. Only type imports from @repo/api/types are allowed."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/typebox-extensions/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@repo/**", "**/apps/**", "**/packages/**"],
                    "message": "TypeBox extensions must be application-independent and have no workspace runtime dependencies."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

{
  "name": "nibrun",
  "type": "module",
  "private": true,
  "scripts": {
    "nib": "bun run packages/cli/src/main.ts",
    "build": "bun run --bun turbo build",
    "check:types": "bun run --bun turbo check:types",
    "test": "bun run --bun turbo test",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun check:types && bun check:codestyle && bun run test",
    "check:commit-message": "bun run --bun commitlint",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "typescript": "^7.0.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/format": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "^1.3.14",
    "typescript": "catalog:",
    "turbo": "^2.10.7"
  },
  "overrides": {
    "bun-types": "canary"
  },
  "packageManager": "bun@1.3.14"
}

{
  "name": "nibrun",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "check:types": "bun run --bun turbo check:types",
    "test": "bun run --bun turbo test",
    "check:codestyle": "bun run --bun biome check",
    "check:all": "bun check:types && bun check:codestyle && bun run test",
    "check:commit-message": "bun run --bun commitlint",
    "fix:codestyle": "bun run --bun biome check --write"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-router": "^1.170.29",
      "@tanstack/router-plugin": "^1.168.23",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "better-auth": "^1.7.2",
      "lucide-react": "^1.28.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.2.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/format": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "^1.4.0",
    "typescript": "catalog:",
    "turbo": "^2.10.7"
  },
  "packageManager": "bun@1.4.0"
}

+export function sqliteForeignKeyLinks({ type, connectionId, origin, query, schema }) {
+  const links = new Map();
+  if (type !== "sqlite" || !origin || origin.connectionId !== connectionId || origin.query !== query) return links;
+  const source = schema.find((object) => object.kind === "table" && samePath({ left: object.path, right: origin.path }));
+  if (!source) return links;
+  for (const foreignKey of source.foreignKeys ?? []) {
+    // The published flat FK metadata loses constraint grouping; ambiguous compound links stay hidden.
+    const siblings = source.foreignKeys.filter((key) => key.referencedTable.toLowerCase() === foreignKey.referencedTable.toLowerCase());
+    if (siblings.length !== 1) continue;
+    const column = source.columns.find((column) => column.name === foreignKey.columnName);
+    // The host displays blobs as text; their original bytes cannot be recovered from that display.
+    if (!column || column.type.toUpperCase().includes("BLOB")) continue;
+    const target = schema.find((object) => object.kind === "table" && object.name.toLowerCase() === foreignKey.referencedTable.toLowerCase());
+    const referencedColumn = target?.columns.find((column) => column.name.toLowerCase() === foreignKey.referencedColumn.toLowerCase());
+    if (target && referencedColumn) links.set(column.name, { path: target.path, table: target.name, column: referencedColumn.name });
+  }
+  return links;
+}
+
+function samePath({ left, right }) {
+  return left.length === right.length && left.every((part, index) => part === right[index]);
+}
+
+function quoteIdentifier(identifier) {
+  return `"${identifier.replaceAll('"', '""')}"`;
+}
+
+export function sqliteReferenceQuery({ link, value }) {
+  let literal;
+  if (typeof value === "number" && Number.isFinite(value)) {
+    literal = String(value);
+  } else if (typeof value === "string" || typeof value === "bigint") {
+    // Hex text preserves embedded NULs and exact integer strings without interpolating SQL tokens.
+    const hex = Array.from(new TextEncoder().encode(String(value)), (byte) => byte.toString(16).padStart(2, "0")).join("");
+    literal = `CAST(X'${hex}' AS TEXT)`;
+  } else {
+    return undefined;
+  }
+  return `SELECT * FROM ${quoteIdentifier(link.table)} WHERE ${quoteIdentifier(link.column)} = ${literal}`;
+}
+
+export function referencedRowTab({ id, connectionId, link, query }) {
+  return { id, name: link.table, query, result: null, isExecuting: false, type: "sql", origin: { path: link.path, connectionId, query } };
+}

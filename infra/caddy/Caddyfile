# Cloudflare terminates TLS and reaches this HTTP listener over Docker networking.
{
	auto_https off
	servers {
		timeouts {
			read_header 10s
		}
	}
}

http://{$API_HOSTNAME} {
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	# A deploy replaces the api container, and its address with it. Dialling by
	# name re-resolves on every attempt, and lb_try_duration holds the request
	# open across the gap where nothing is listening rather than answering 502 —
	# measured surviving 8s of downtime and a changed container address.
	handle {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto https
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# The private listener, reachable only from fleet hosts: the security group
# admits this port from their security groups, and the public HTTP listener
# answers 404 for the same paths.
#
# It is a separate listener rather than another path on 443 because Cloudflare
# closes a proxied request at about 100 seconds, and the agent long-polls for up
# to 300. Routing control traffic through the edge would break the poll, not
# merely expose it.
:{$INTERNAL_PORT} {
	@internal path /internal/*
	handle @internal {
		reverse_proxy api:3000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		respond 404
	}
}

# Log ingest from the fleet. Admitted from the app hosts' security group only,
# exactly as the control channel above, and plain HTTP for the same reason.
#
# A listener of its own rather than another matcher on the internal port: the two
# carry different traffic — one long poll per host against a continuous stream of
# writes — and a mistake in a shared matcher would put one of them on whichever
# port was meant to answer for the other.
#
# Only /insert. Reads go through the api, which is what decides whether a caller
# may see the app it is asking about; nothing on an app host reads logs back, so
# exposing /select here would only widen what a compromised host can do.
:{$LOG_INGEST_PORT} {
	@insert path /insert/*
	handle @insert {
		# Held rather than refused while the store is away: a shipper that gets an
		# error here drops the lines it was carrying, and they are the record of
		# what the fleet was doing at the one moment worth reading back.
		reverse_proxy victorialogs:9428 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		respond 404
	}
}

# Container logs. Dozzle authenticates its own visitors (simple auth, prod only)
# — the edge only gets them here, and deliberately does not add a second gate in
# front of the login page.
http://{$DOZZLE_HOSTNAME} {
	# Log streaming is a websocket; reverse_proxy upgrades it as-is, and the
	# retries below sit before the upgrade, where a dial that never connected is
	# safe to repeat.
	reverse_proxy dozzle:8080 {
		header_up X-Forwarded-Proto https
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

http://{$UMAMI_HOSTNAME} {
	reverse_proxy umami:3000 {
		header_up X-Forwarded-Proto https
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# The fleet's logs. Unlike Dozzle, VictoriaLogs has no login of its own and no
# way to expose a subset of itself: one -httpAuth credential covers every
# endpoint including /insert, and -select.disable is all-or-nothing. So both the
# gate and the endpoint allowlist are here.
http://{$VICTORIALOGS_HOSTNAME} {
	# Rendered by on_box_deploy.sh from the SSM password, the way Dozzle's user
	# list is; bcrypt is what basic_auth reads, and nothing on the box holds the
	# password itself. A file under the mounted directory rather than an
	# environment variable because bcrypt re-salts on every run: the same
	# password hashes differently each deploy, which through the environment
	# would change the edge's compose config and recreate it every time. Here the
	# new hash arrives through the reload and the container is never touched.
	import /etc/caddy/auth/victorialogs.caddy

	# Nothing is served at the bare hostname — the allowlist below starts at
	# /select — so this is what makes typing the hostname land on the dashboard
	# rather than a 404. A redirect, not a proxy: it publishes no new path.
	# Temporary, so the destination can move without browsers having cached it.
	@root path /
	handle @root {
		redir * /select/vmui/
	}

	# vmui is served from /select/vmui/ and loads every asset relative to it, and
	# its queries are /select/logsql/*. So this is the whole dashboard and nothing
	# else: /insert stays reachable only on the ingest listener above, and the
	# version page, /metrics and /flags are not published at all.
	@select path /select/*
	handle @select {
		reverse_proxy victorialogs:9428 {
			header_up X-Forwarded-Proto https
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		respond 404
	}
}

http:// {
	respond 404
}

# The public edge, and the only thing on the box listening off-loopback.
# Cloudflare terminates the visitor's TLS; this terminates the edge-to-origin
# leg. Two hostnames, two upstreams — routing for user apps is a later phase.
{
	# No ACME: the certificate is a Cloudflare Origin Certificate, which the
	# deploy fetches from SSM and writes into tls/ next to this file. It names
	# every hostname below, so both sites serve the same pair.
	auto_https off
}

# Authenticated Origin Pulls. The origin IP is discoverable, so the edge has to
# prove it is the edge: without a client certificate signed by Cloudflare's
# origin-pull CA the handshake is refused before any request is read. Turning
# this on also makes Caddy enforce SNI == Host, which closes Host-header
# spoofing along with it.
#
# A snippet because every site needs it identically, and a site that quietly
# went without would accept connections straight from the origin IP.
(origin_tls) {
	tls /etc/caddy/tls/origin.crt /etc/caddy/tls/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
		}
	}
}

https://{$API_HOSTNAME} {
	import origin_tls

	# The api serves nothing under /internal yet. Denying the namespace before
	# it exists is the point: fleet-host agents reach the api over the private
	# network, and a route added there later would otherwise be public from the
	# moment it is written, with nothing to notice it.
	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	# A deploy replaces the api container, and its address with it. Dialling by
	# name re-resolves on every attempt, and lb_try_duration holds the request
	# open across the gap where nothing is listening rather than answering 502 —
	# measured surviving 8s of downtime and a changed container address.
	handle {
		reverse_proxy api:3000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}
}

# The private listener, reachable only from an app host: the security group
# admits this port from the app hosts' group and nothing else, and the public
# edge above answers 404 for the same paths. Plain HTTP — a Cloudflare Origin
# Certificate names hostnames, and an agent dials a private address.
#
# It is a separate listener rather than another path on 443 because Cloudflare
# closes a proxied request at about 100 seconds, and the agent long-polls for up
# to 300. Routing control traffic through the edge would break the poll, not
# merely expose it.
:{$INTERNAL_PORT} {
	@internal path /internal/*
	handle @internal {
		reverse_proxy api:3000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		respond 404
	}
}

# Log ingest from the fleet. Admitted from the app hosts' security group only,
# exactly as the control channel above, and plain HTTP for the same reason.
#
# A listener of its own rather than another matcher on the internal port: the two
# carry different traffic — one long poll per host against a continuous stream of
# writes — and a mistake in a shared matcher would put one of them on whichever
# port was meant to answer for the other.
#
# Only /insert. Reads go through the api, which is what decides whether a caller
# may see the app it is asking about; nothing on an app host reads logs back, so
# exposing /select here would only widen what a compromised host can do.
:{$LOG_INGEST_PORT} {
	@insert path /insert/*
	handle @insert {
		reverse_proxy victorialogs:9428
	}

	handle {
		respond 404
	}
}

# Container logs. Dozzle authenticates its own visitors (simple auth, prod only)
# — the edge only gets them here, and deliberately does not add a second gate in
# front of the login page.
https://{$DOZZLE_HOSTNAME} {
	import origin_tls

	# Log streaming is a websocket; reverse_proxy upgrades it as-is. No
	# lb_try_duration: nothing recreates this container on deploy, so there is no
	# gap to ride out, and holding a request open would only delay the 502 that
	# says Dozzle is actually down.
	reverse_proxy dozzle:8080
}

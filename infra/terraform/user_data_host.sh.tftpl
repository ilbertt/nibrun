#!/bin/bash
set -euxo pipefail

# Prerequisites only. The agent binary, its unit file and its env file arrive
# with the deploy, because the agent is built from this repo and the host token
# it needs lives in SSM.

dnf update -y
dnf install -y unzip

# Docker backs the container runner. The process runner needs none of this and
# the Firecracker runner needs /dev/kvm, which only exists on a bare-metal
# instance type — see host_instance_type.
dnf install -y docker
systemctl enable --now docker

# Not guaranteed on minimal AL2023, and the on-host deploy needs it to read the
# host token from SSM.
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

mkdir -p /opt/nibrun /etc/nibrun
chown ec2-user:ec2-user /opt/nibrun

touch /opt/nibrun-bootstrap.done

      "title": "Apps by state",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (nibrunner_app_state{job=\"nibrunner\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },

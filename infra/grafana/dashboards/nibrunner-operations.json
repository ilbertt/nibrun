{
  "uid": "nibrunner-operations",
  "title": "nibrunner operations",
  "description": "Private host, app, request and lifecycle metrics.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": ["nibrunner"],
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/nibrunner-logs",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "title": "Apps by state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (nibrunner_app_state{job=\"nibrunner\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Metrics reporting",
      "description": "Scrape status at the end of the selected time range. Reporting requires a successful scrape within two minutes; failed, missing or stale samples are not reporting.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"nibrunner\"} * (time() - timestamp(up{job=\"nibrunner\"}) <= bool 120)) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Not reporting",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Not reporting", "color": "red" },
                "1": { "text": "Reporting", "color": "green" }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "text": { "valueSize": 20 },
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "title": "Host memory available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_host_memory_available_bytes{job=\"nibrunner\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "Host capacity and allocatable",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_host_capacity{job=\"nibrunner\"}",
          "legendFormat": "{{instance}} capacity {{resource}}"
        },
        {
          "refId": "B",
          "expr": "nibrunner_host_allocatable{job=\"nibrunner\"}",
          "legendFormat": "{{instance}} allocatable {{resource}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "title": "Slots",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_slots{job=\"nibrunner\"}",
          "legendFormat": "{{instance}} {{of}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Conntrack entries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_conntrack_entries{job=\"nibrunner\"}",
          "legendFormat": "{{instance}} {{of}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "title": "Requests by proxy outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(nibrunner_proxy_requests_total{job=\"nibrunner\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "title": "Customer responses by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(nibrunner_app_requests_total{job=\"nibrunner\"}[5m]))",
          "legendFormat": "{{class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "title": "Requests by app",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (rate(nibrunner_app_requests_total{job=\"nibrunner\"}[5m]))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "title": "App memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_app_memory_used_bytes{job=\"nibrunner\"}",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "title": "Wake phases",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, phase, outcome) (rate(nibrunner_wake_phase_seconds_bucket{job=\"nibrunner\"}[1h])))",
          "legendFormat": "p95 {{phase}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "title": "Deployment phases",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(nibrunner_converge_seconds_bucket{job=\"nibrunner\",cause=\"change\",desired_state=~\"running|on-request\"}[1h])))",
          "legendFormat": "p95 {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "title": "App failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(nibrunner_app_failures_total{job=\"nibrunner\"}[1h]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      }
    },
    {
      "title": "App convergence",
      "description": "Whether every app matches its requested deployment and state at the end of the selected time range. Missing samples or samples older than two minutes show Unknown.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_host_converged{job=\"nibrunner\"} and (time() - timestamp(nibrunner_host_converged{job=\"nibrunner\"}) <= 120)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Pending", "color": "yellow" },
                "1": { "text": "Converged", "color": "green" }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": { "text": "Unknown", "color": "gray" }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": { "valueSize": 20, "titleSize": 12 },
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        }
      },
      "id": 14,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 48
      }
    },
    {
      "id": 15,
      "title": "Host isolation",
      "description": "Whether the host isolation ruleset is applied. When it is not, nibrunner blocks app starts and wakes. Missing samples or samples older than two minutes show Unknown.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nibrunner_host_isolated{job=\"nibrunner\"} and (time() - timestamp(nibrunner_host_isolated{job=\"nibrunner\"}) <= 120)",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Not applied", "color": "red" },
                "1": { "text": "Applied", "color": "green" }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": { "text": "Unknown", "color": "gray" }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": false,
        "text": { "valueSize": 20, "titleSize": 12 },
        "reduceOptions": {
          "calcs": ["last"],
          "fields": "",
          "values": false
        }
      },
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 48 }
    },
    {
      "id": 16,
      "title": "Apps not converged",
      "description": "Apps whose deployment or state differs from the requested one. Select an app to view its logs. Only samples from the last two minutes are shown; check host status to distinguish all apps converged from missing telemetry.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(nibrunner_app_converged{job=\"nibrunner\"} == 0) and (time() - timestamp(nibrunner_app_converged{job=\"nibrunner\"}) <= 120)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "job": true,
              "__name__": true
            },
            "indexByName": { "app": 0, "instance": 1 },
            "renameByName": { "app": "App", "instance": "Host" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "filterable": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "App" },
            "properties": [
              { "id": "custom.width", "value": 270 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "View app logs",
                    "url": "/d/nibrunner-logs?var-query=appId%3A%3D%22${__value.raw:percentencode}%22&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "App", "desc": false }]
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 51 }
    }
  ]
}

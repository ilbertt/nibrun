{
  "uid": "docker-operations",
  "title": "Docker containers",
  "description": "Control-plane Docker containers. CPU is measured as a percentage of one core. Container labels use the Compose service name when available.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": ["docker"],
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU use (percent of one core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{job=\"integrations/docker\",container!=\"\"}[5m])) * 100",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Memory working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "nibrunner-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{job=\"integrations/docker\",container!=\"\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Network received",

[Unit]
Description=nibrunner instance-store cache and snapshots
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=nibrunnerd.service nibrunner-zerofs.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/nibrun/nibrunner-host/ensure_ephemeral_data.sh zerofs zerofs zerofs-checkpoint
ExecStartPost=/usr/bin/install -d -m 0755 /data/nibrunner-vm

[Install]
WantedBy=multi-user.target

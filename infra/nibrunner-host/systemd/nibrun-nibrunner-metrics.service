[Unit]
Description=nibrunner metrics collection
Wants=network-online.target
After=network-online.target nibrunnerd.service

[Service]
User=alloy
Group=alloy
ExecStart=/usr/bin/alloy run --server.http.listen-addr=127.0.0.1:12345 --storage.path=/var/lib/nibrunner-metrics /etc/nibrunner-metrics/config.alloy
Restart=always
RestartSec=5
StateDirectory=nibrunner-metrics
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=25%
Nice=10

[Install]
WantedBy=multi-user.target

# Every pinned input to the guest image. Sourced by build.sh and version.sh, and
# copied verbatim into the manifest, so a published artifact always names what it
# was built from.

# Keep the validated 6.1 guest configuration while taking stable security fixes.
# CVE-2026-98432 is fixed from 6.1.190; kernel.org publishes this tarball's checksum.
KERNEL_VERSION=6.1.191
KERNEL_SHA256=02f15b77d213e15607923832ef9382e2414ea90df6c007f15a910e139645c35d

# The base .config is vendored at this commit, not fetched during the build —
# fetching it would put an input outside the reach of the version digest. The
# commit is what v1.16.1 resolves to; the tag is recorded for humans and is not
# what the build trusts.
#
# The Firecracker *binary* the hosts run should stay on this same tag. That pin
# is not ours to make, so it is written down rather than declared: one tarball
# carries both binaries, firecracker-v1.16.1-x86_64.tgz, sha256
# 382a02a869e4d6d5cb14c40577f9545e8458021ea8b0b2d3fc10ec14d9c242e6, extracting
# to a flat release-v1.16.1-x86_64/ holding firecracker-v1.16.1-x86_64 and
# jailer-v1.16.1-x86_64. Nothing here fetches a prebuilt CI kernel and nothing
# should: upstream's s3://spec.ccfc.min/firecracker-ci/v<tag>/ prefix does not
# exist for v1.16, so a script deriving it from the release tag downloads
# nothing and reports success.
FIRECRACKER_REF=v1.16.1
FIRECRACKER_COMMIT=2038188f145fb81b8d098147a10e9d9f392fd22f
FIRECRACKER_CONFIG_SHA256=adbc70ab5e89213ba00594b12d25e09bdf8bb1ed3c252d7449326bb14c22963b

# APT 3.0.4 fixes the download-retry memory bug that can stall snapshot installs.
DEBIAN_IMAGE=debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

# Fed to KBUILD_BUILD_TIMESTAMP, to mke2fs, and to the mtime of every file in the
# rootfs. Bumping it changes every artifact byte, so it is pinned rather than
# taken from the clock.
SOURCE_DATE_EPOCH=1783987200

# mke2fs would otherwise generate both at random, which alone would make two runs
# of an unchanged input tree produce different bytes.
ROOTFS_UUID=6e696272-756e-4700-b755-657374000001
ROOTFS_HASH_SEED=6e696272-756e-4700-b755-657374000002

ROOTFS_LABEL=nibrun-root

# nibrun's delta on top of Firecracker's CI guest config.
#
# Most of what the guest boot contract needs is already in the base config. Those
# symbols are re-asserted here rather than assumed, because assert-config.sh
# fails the build on any line in this file the generated .config does not match
# exactly. That turns "a Firecracker config bump quietly dropped squashfs" from a
# boot failure on a tenant's VM into a build failure in CI.
#
# Everything above the divider is therefore expected to be a no-op merge today.
# Everything below it is a real change to the base config.

# vda: the rootfs itself — ext4 on virtio-blk, mounted ro. MODULES is off in the
# base config, so anything not built in here can never be loaded later.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y

# vdb (tenant artifact) and vdc (instance config) are squashfs. The image carries
# every compressor the artifact builder might pick, because picking one it cannot
# decompress fails at mount time with the tenant already booting.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZLIB=y

# vda is read-only, so every writable path in the guest is a tmpfs /init mounts.
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# The cmdline carries a static `ip=…:off`, so the kernel configures eth0 itself
# before /init runs and the guest ships no DHCP client at all.
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_BOOTP=y

# The runtime sends tenant stdout and stderr to the host over Firecracker's
# guest-initiated vsock path. Firecracker implements the host side itself, so the
# guest virtio transport is built in while the host-only vhost driver stays out.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# /init drops to an unprivileged uid before exec'ing the tenant binary.
CONFIG_MULTIUSER=y

# Firecracker's own minimum for an x86_64 guest. CONFIG_PCI stays on despite
# `pci=off` on the cmdline — the flag suppresses bus scanning, ACPI init still
# needs the symbol built in, and dropping it is the kind of "obvious" trim that
# produces a kernel that never reaches userspace.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PRINTK=y

# console=ttyS0 is the whole logging path: tenant stdout reaches Firecracker's
# stdout and lands in the journal.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Firecracker emulates no RTC on x86_64, so kvmclock is the only source of wall
# time — and a guest that thinks it is 1970 cannot validate a TLS certificate.
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y

# TLS also needs the CRNG seeded before the tenant's first outbound connection,
# and a microVM has almost no entropy of its own to offer.
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_RANDOM_TRUST_CPU=y

# --- real changes to the base config below ---

# The cmdline already carries `panic=1 reboot=k`, so a panic ends the VM and the
# agent restarts it. An oops is not a panic: without this the kernel limps on in
# an undefined state while still serving the tenant. One VM per tenant means
# there is nothing worth preserving by surviving.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_ON_OOPS_VALUE=1

# Embeds the config into the ELF, so `scripts/extract-ikconfig vmlinux` can prove
# what a kernel already on a host was built with, without the build tree that
# produced it.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# A graceful stop is Firecracker's SendCtrlAltDel, which is an AT keyboard event on
# the i8042 — so with these off the guest never hears "please stop". Measured, not
# assumed: with the base config the API answered 204 and reported success while the
# guest ignored the action entirely, leaving no way to stop a VM but killing the VMM
# with the tenant mid-write. The base config turns all four off.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y

# Copy to .env and fill in. Never commit .env.
#
# Every value here is per-deployment: secrets, host port bindings, and public
# URLs. Internal service URLs and container ports are fixed by the compose
# topology and live in docker-compose.yml.
#
# The api reads unprefixed names (PORT, DATABASE_URL, S3_*); the API_ prefix
# here namespaces the whole stack — the database and object store exist to serve
# the api — and docker-compose.yml maps each one onto the name its image expects.

# --- Release images ---
# Prod only (docker-compose.prod.yml); local builds the api from source.

API_IMAGE_URI=

# --- API ---

# Host port the api binds to. The container always listens on 3000.
API_PORT=3000
# How browsers reach the deployment. Update together with API_PORT.
API_BASE_URL=http://localhost:3000
# Session signing secret. Generate with: openssl rand -base64 32
API_BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me-0000

# GitHub sign-in. Create an OAuth App at https://github.com/settings/developers
# whose callback URL is exactly $API_BASE_URL/api/auth/callback/github. One app
# per deployment: GitHub allows a single callback URL per OAuth App.
API_GITHUB_CLIENT_ID=
API_GITHUB_CLIENT_SECRET=

# --- Database ---
# Host (`postgres-db`) and port (5432) are fixed by the compose topology and
# hardcoded in docker-compose.yml. The api owns the database outright and runs
# its own migrations at startup, so this role is also the Postgres superuser.

API_DB_USER=nibrun
API_DB_PASSWORD=nibrun
API_DB_NAME=nibrun
# Loopback only (127.0.0.1); SSH-tunnel from your laptop to reach it remotely.
API_DB_PORT=5432

# --- Object storage ---
# Backed by MinIO in the stack; the api talks plain S3 to it at http://minio:9000.
# The credentials double as MinIO's root user, so the key needs 3+ characters and
# the secret 8+.

ARTIFACTS_BUCKET=nibrun
# SigV4 signs against a region whatever the store does with it: MinIO ignores it,
# AWS rejects a signature naming the wrong one.
AWS_REGION=us-east-1

# Generated by Terraform in production and read from SSM by both machine classes.
AGENT_BOOTSTRAP_TOKEN=local-development-only
API_S3_ACCESS_KEY_ID=nibrun
API_S3_SECRET_ACCESS_KEY=nibrun-local-secret
# Loopback only (127.0.0.1). S3 API, then the MinIO web console.
API_S3_PORT=9000
API_S3_CONSOLE_PORT=9001

# --- Tenant apps ---
# Domain user apps are served under, as <slug>.<APP_HOST_DOMAIN>. Deliberately a
# different registrable domain from API_BASE_URL: sharing one would put tenant
# apps inside the dashboard's cookie scope.

APP_HOST_DOMAIN=apps.localhost

# --- Logs ---
# Dozzle reads the Docker socket and serves every container's logs, with no
# login of its own. Loopback only (127.0.0.1); SSH-tunnel from your laptop to
# reach it remotely.

DOZZLE_PORT=8080

# VictoriaLogs holds the fleet's logs: tenant output and each app host's own
# journal. Loopback only, like Dozzle — its UI is at /select/vmui. Writes arrive
# through Caddy on LOG_INGEST_PORT and the api queries it over the compose
# network, so neither uses this binding.

VICTORIALOGS_PORT=9428
# Storage is local disk, so this is bounded by the data volume rather than by an
# object store. Nothing tiers older data off the box.
VICTORIALOGS_RETENTION_PERIOD=30d

# Where app hosts write logs. Generated by Terraform in production, where the
# security group admits it from the app hosts' group and nothing else; locally
# there is no fleet, so it only has to be a free port.
LOG_INGEST_PORT=19081

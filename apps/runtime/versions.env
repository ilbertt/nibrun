# The toolchain that builds /init. Pinned here rather than shared with
# infra/guest-image because the built binary is one of the inputs to that image's
# version digest: a toolchain that drifts would publish a new guest image out of an
# unchanged source tree.

BUILDER_IMAGE=debian:trixie-slim@sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# Packages come from snapshot.debian.org at this timestamp, not from the live
# archive: the image digest pins the starting layer, this pins musl and gcc.
DEBIAN_SNAPSHOT=20260714T000000Z

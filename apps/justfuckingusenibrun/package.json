{
  "name": "@repo/justfuckingusenibrun",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "PORT=3003 bun run src/server.ts",
    "build": "bun build --compile --target=bun-linux-x64 --outfile dist/justfuckingusenibrun src/server.ts",
    "check:types": "bun run --bun tsc",
    "deploy": "bun run build && bun run ../../packages/cli/src/main.ts run ./dist/justfuckingusenibrun --app justfuckingusenibrun"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}

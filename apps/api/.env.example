PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://nibrun:nibrun@localhost:5432/nibrun
BETTER_AUTH_SECRET=dev-secret

# github sign-in (https://github.com/settings/developers → OAuth Apps)
# The app's callback URL must be exactly $BASE_URL/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# artifact storage (MinIO locally, S3/R2 in production)
S3_ENDPOINT=http://localhost:9000
ARTIFACTS_BUCKET=nibrun-artifacts
S3_ACCESS_KEY_ID=nibrun
S3_SECRET_ACCESS_KEY=nibrun-secret

{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@repo/dashboard#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/deploy-to-nibrun/**"],
      "outputs": ["dist/**", "public/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/deploy-to-nibrun/**"]
    }
  }
}

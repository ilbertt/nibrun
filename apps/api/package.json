{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    "./types": "./src/types.ts",
    "./lib/api/*": "./src/lib/api/*.ts",
    "./lib/app-config-defaults": "./src/lib/app-config-defaults.ts",
    "./lib/dns-records": "./src/lib/dns-records.ts",
    "./lib/redact-secrets": "./src/lib/redact-secrets.ts",
    "./lib/runtime-values": "./src/lib/runtime-values.ts",
    "./lib/seen-tenant-logs": "./src/lib/seen-tenant-logs.ts"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:types": "bun codegen:sql:check && bun run --bun tsc",
    "codegen:sql": "bun bun-sqlgen generate 'src/repositories/*.repository.ts' --migrations src/db/migrations --out src/db/queries.gen.ts",
    "codegen:sql:check": "bun codegen:sql --check",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@ilbertt/better-auth-bun-sql": "^0.4.0",
    "@ilbertt/bun-sqlgen": "^0.6.2",
    "@repo/protocol": "workspace:*",
    "better-auth": "catalog:",
    "elysia": "^1.4.30",
    "tldts": "^7.4.13",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}

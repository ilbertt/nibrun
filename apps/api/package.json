{
  "name": "@repo/api",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "exports": {
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:types": "bun codegen:sql:check && bun run --bun tsc",
    "codegen:sql": "bun bun-sqlgen generate 'src/repositories/*.repository.ts' --migrations src/db/migrations --out src/db/queries.gen.ts",
    "codegen:sql:check": "bun codegen:sql --check",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@better-auth/api-key": "1.7.7",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "catalog:",
    "@better-auth/mcp": "1.7.7",
    "@elysia/cors": "^1.4.2",
    "@ilbertt/better-auth-bun-sql": "^0.4.1",
    "@ilbertt/bun-sqlgen": "^0.7.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@repo/api-constants": "workspace:*",
    "@repo/app-ui": "workspace:*",
    "@repo/protocol": "workspace:*",
    "@repo/sqlite": "workspace:*",
    "@repo/typebox-extensions": "workspace:*",
    "@sinclair/typebox": "catalog:",
    "better-auth": "catalog:",
    "elysia": "^1.4.30",
    "jose": "^6.2.14",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "catalog:",
    "@libsql/client": "catalog:"
  }
}

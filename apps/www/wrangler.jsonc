{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibrun-www",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "binding": "ASSETS",
    // Default is `auto-trailing-slash`, which answers /blog by redirecting to /blog/ — a URL
    // that is not the one the page names as its canonical. Dropping it instead makes the two
    // agree, so the address that gets shared is the address that gets served.
    "html_handling": "drop-trailing-slash"
  },
  // `wrangler preview` refuses to run without this block. It is empty because the only binding
  // is the assets, which stay top-level and serve a preview the same way they serve production.
  "previews": {}
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nibrun-www",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "binding": "ASSETS"
  }
}
